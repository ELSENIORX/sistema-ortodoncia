# Cadena de conexión de PostgreSQL.
# Con Docker Compose local:
DATABASE_URL="postgresql://ortodoncia:ortodoncia@localhost:5432/ortodoncia?schema=public"

# Secreto usado para firmar la cookie de sesión (genera uno con: openssl rand -hex 32).
SESSION_SECRET="cambia-este-secreto-en-produccion-0000000000000000"
